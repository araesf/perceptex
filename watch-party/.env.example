# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/watchparty

# MongoDB root password for Docker deployment - Generate with: openssl rand -hex 32
MONGO_PASSWORD=

# JWT Secret - REQUIRED - Generate with: openssl rand -hex 32
# CRITICAL: Never commit the actual secret to git
JWT_SECRET=

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL for CORS
CLIENT_URL=http://localhost:3000

# AWS EC2 Configuration (for deployment)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
